<Window x:Class="FashionWarehouse.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FASHION WMS - QUẢN LÝ KHO QUẦN ÁO"
        Height="800" Width="1350"
        MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#F4F6F9">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar menu -->
        <Border Grid.Column="0" Background="#1E293B">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="92"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="82"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Border Width="45" Height="45" CornerRadius="8" Background="#3B82F6">
                        <TextBlock Text="FW" FontWeight="Bold" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="FASHION WMS" FontWeight="Bold" FontSize="16" Foreground="White"/>
                        <TextBlock Text="Kho Hàng Thời Trang" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="12,16,12,0">
                    <Button Name="btnDashboard" Click="BtnDashboard_Click" Tag="Dashboard" Height="46" Margin="0,4" HorizontalContentAlignment="Left" Background="#2563EB" Foreground="White" BorderThickness="0" Padding="16,0" Cursor="Hand">
                        <TextBlock Text="▣   Tổng quan (Dashboard)" FontWeight="SemiBold"/>
                    </Button>
                    <Button Name="btnProducts" Click="BtnProducts_Click" Tag="Products" Height="46" Margin="0,4" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="16,0" Cursor="Hand">
                        <TextBlock Text="👕  Quản lý Sản phẩm &amp; SKU"/>
                    </Button>
                    <Button Name="btnReceipts" Click="BtnReceipts_Click" Tag="Receipts" Height="46" Margin="0,4" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="16,0" Cursor="Hand">
                        <TextBlock Text="▤   Nhập / Xuất Kho"/>
                    </Button>
                    <Button Click="BtnComingSoon_Click" Height="46" Margin="0,4" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="16,0" Cursor="Hand">
                        <TextBlock Text="▦   Tồn kho &amp; Vị trí kệ"/>
                    </Button>
                    <Button Click="BtnComingSoon_Click" Height="46" Margin="0,4" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="16,0" Cursor="Hand">
                        <TextBlock Text="▥   Báo cáo &amp; Thống kê"/>
                    </Button>
                    <Button Click="BtnComingSoon_Click" Height="46" Margin="0,4" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="16,0" Cursor="Hand">
                        <TextBlock Text="♙   Nhân viên &amp; Phân quyền"/>
                    </Button>
                </StackPanel>

                <!-- User detail -->
                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#334155" Padding="16,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Nguyễn Quản Trị" FontWeight="SemiBold" FontSize="13" Foreground="White"/>
                        <TextBlock Text="Quản trị viên (Admin)" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="66"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0" Padding="25,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Name="txtPageTitle" Text="BẢNG ĐIỀU KHIỂN TRUNG TÂM" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Name="txtPageSubTitle" Text="Dữ liệu minh họa giao diện quản lý kho thời trang" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                    <Button Grid.Column="1" Click="BtnReceipts_Click" Height="38" Background="#10B981" Foreground="White" BorderThickness="0" Padding="16,0" Cursor="Hand">
                        <TextBlock Text="+ Tạo phiếu Nhập/Xuất" FontWeight="SemiBold"/>
                    </Button>
                </Grid>
            </Border>

            <ContentControl Name="MainContent" Grid.Row="1" Margin="25"/>
        </Grid>
    </Grid>
</Window>
