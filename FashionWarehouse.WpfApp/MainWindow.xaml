<Window x:Class="FashionWarehouse.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FASHION WMS - QUẢN LÝ KHO QUẦN ÁO"
        Height="800" Width="1350"
        MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#F4F6F9">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar menu -->
        <Border Grid.Column="0" Background="#1E293B">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="92"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="90"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="48" Height="48" CornerRadius="10" Background="White" Padding="2" BorderBrush="#3B82F6" BorderThickness="1.5">
                        <Image Source="/Assets/logo.png" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="FASHION WMS" FontWeight="Bold" FontSize="16" Foreground="White"/>
                        <TextBlock Text="Kho Hàng Thời Trang" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,12,12,12">
                        <Button Name="btnDashboard" Click="BtnDashboard_Click" Tag="Dashboard" Height="44" Margin="0,3" HorizontalContentAlignment="Left" Background="#2563EB" Foreground="White" BorderThickness="0" Padding="14,0" Cursor="Hand">
                            <TextBlock Text="▣   Tổng quan (Dashboard)" FontWeight="SemiBold"/>
                        </Button>
                        <Button Name="btnProducts" Click="BtnProducts_Click" Tag="Products" Height="44" Margin="0,3" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="14,0" Cursor="Hand">
                            <TextBlock Text="👕  Quản lý Sản phẩm &amp; SKU"/>
                        </Button>
                        <Button Name="btnCategories" Click="BtnCategories_Click" Tag="Categories" Height="44" Margin="0,3" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="14,0" Cursor="Hand">
                            <TextBlock Text="📂  Quản lý Danh mục"/>
                        </Button>
                        <Button Name="btnSuppliers" Click="BtnSuppliers_Click" Tag="Suppliers" Height="44" Margin="0,3" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="14,0" Cursor="Hand">
                            <TextBlock Text="🏭  Quản lý Nhà cung cấp"/>
                        </Button>
                        <Button Name="btnCustomers" Click="BtnCustomers_Click" Tag="Customers" Height="44" Margin="0,3" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="14,0" Cursor="Hand">
                            <TextBlock Text="👥  Quản lý Khách hàng"/>
                        </Button>

                        <!-- Menu Giao Dịch Kho (Nhánh mẹ mở rộng / thu gọn theo mẫu Phenikaa) -->
                        <Button Name="btnTransactionGroup" Click="BtnTransactionGroup_Click" Height="44" Margin="0,3" HorizontalContentAlignment="Stretch" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="14,0" Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📦  Giao dịch kho" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Name="txtTransChevron" Grid.Column="1" Text="▼" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Khung menu con phân nhánh dọc (Submenu Branch with Bullets) -->
                        <Grid Name="pnlTransactionSubmenu" Margin="14,0,0,4">
                            <!-- Đường kẻ dọc phân nhánh (Tree vertical line) -->
                            <Rectangle Width="2" Fill="#334155" HorizontalAlignment="Left" Margin="10,4,0,4"/>

                            <StackPanel Margin="18,0,0,0">
                                <!-- Nhánh 1: Nhập kho -->
                                <Button Name="btnImport" Click="BtnImport_Click" Height="36" Margin="0,2" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="6,0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#10B981" Margin="-15,0,9,0"/>
                                        <TextBlock Text="📥  Nhập kho (NCC)"/>
                                    </StackPanel>
                                </Button>

                                <!-- Nhánh 2: Xuất kho -->
                                <Button Name="btnExport" Click="BtnExport_Click" Height="36" Margin="0,2" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="6,0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#EF4444" Margin="-15,0,9,0"/>
                                        <TextBlock Text="📤  Xuất kho (Đại lý)"/>
                                    </StackPanel>
                                </Button>

                                <!-- Nhánh 3: Hóa đơn & Lịch sử phiếu -->
                                <Button Name="btnReceiptHistory" Click="BtnReceiptHistory_Click" Height="36" Margin="0,2" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="6,0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#3B82F6" Margin="-15,0,9,0"/>
                                        <TextBlock Text="🧾  Hóa đơn &amp; Lịch sử"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Button Name="btnLocations" Click="BtnLocations_Click" Tag="Locations" Height="44" Margin="0,3" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="14,0" Cursor="Hand">
                            <TextBlock Text="🏬   Quản lý Kho &amp; Vị trí kệ"/>
                        </Button>
                        <Button Name="btnInventory" Click="BtnInventory_Click" Tag="Inventory" Height="44" Margin="0,3" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="14,0" Cursor="Hand">
                            <TextBlock Text="▦   Tồn kho &amp; Vị trí kệ"/>
                        </Button>
                        <Button Name="btnReports" Click="BtnReports_Click" Tag="Reports" Height="44" Margin="0,3" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="14,0" Cursor="Hand">
                            <TextBlock Text="▥   Báo cáo &amp; Thống kê"/>
                        </Button>
                        <Button Name="btnEmployees" Click="BtnEmployees_Click" Tag="Employees" Height="44" Margin="0,3" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="14,0" Cursor="Hand">
                            <TextBlock Text="♙   Nhân viên &amp; Phân quyền"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- User detail & Logout -->
                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#334155" Padding="16,10">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Name="txtUserFullName" Text="Nguyễn Quản Trị" FontWeight="SemiBold" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Name="txtUserRole" Text="Quản trị viên (Admin)" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Button Grid.Column="1" Click="BtnLogout_Click" ToolTip="Đăng xuất khỏi hệ thống" Background="#EF4444" Foreground="White" BorderThickness="0" Padding="8,4" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="Đăng xuất" FontSize="11" FontWeight="SemiBold"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="66"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0" Padding="25,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Name="txtPageTitle" Text="BẢNG ĐIỀU KHIỂN TRUNG TÂM" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Name="txtPageSubTitle" Text="Dữ liệu minh họa giao diện quản lý kho thời trang" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                    <Button Grid.Column="1" Click="BtnReceipts_Click" Height="38" Background="#10B981" Foreground="White" BorderThickness="0" Padding="16,0" Cursor="Hand">
                        <TextBlock Text="+ Tạo phiếu Nhập/Xuất" FontWeight="SemiBold"/>
                    </Button>
                </Grid>
            </Border>

            <ContentControl Name="MainContent" Grid.Row="1" Margin="25"/>
        </Grid>
    </Grid>
</Window>

