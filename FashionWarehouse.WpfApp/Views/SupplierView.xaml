<UserControl x:Class="FashionWarehouse.WpfApp.Views.SupplierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- KPI Cards -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1 -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="TỔNG NHÀ CUNG CẤP" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="txtKpiTotal" Text="0" FontSize="26" FontWeight="Bold" Foreground="#1E293B" Margin="0,6,0,2"/>
                    <TextBlock Text="Doanh nghiệp may mặc &amp; phụ liệu" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Card 2 -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="ĐANG HỢP TÁC &amp; GIAO HÀNG" FontSize="11" FontWeight="Bold" Foreground="#059669"/>
                    <TextBlock x:Name="txtKpiActive" Text="0" FontSize="26" FontWeight="Bold" Foreground="#10B981" Margin="0,6,0,2"/>
                    <TextBlock Text="Sẵn sàng nhập hàng vào kho" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Card 3 -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="TỔNG SỐ LẦN NHẬP KHO" FontSize="11" FontWeight="Bold" Foreground="#2563EB"/>
                    <TextBlock x:Name="txtKpiReceipts" Text="0" FontSize="26" FontWeight="Bold" Foreground="#3B82F6" Margin="0,6,0,2"/>
                    <TextBlock Text="Lượt cung ứng vật tư &amp; quần áo" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Thanh tìm kiếm & Thông báo -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="txtSearch" Height="38" Padding="10,0" VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_TextChanged"/>
                    <TextBlock Text="🔍 Tìm NCC theo tên, đại diện, SĐT..." Foreground="#94A3B8"
                               VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <TextBlock x:Name="lblStatusMessage" Grid.Column="1" VerticalAlignment="Center" Margin="15,0"
                           FontWeight="SemiBold" FontSize="12" Foreground="#059669"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Click="BtnRefresh_Click" Height="38" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" Padding="14,0" Margin="0,0,10,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="🔄 Làm Mới"/>
                    </Button>

                    <Button Click="BtnNewSupplier_Click" Height="38" Background="#10B981" Foreground="White" BorderThickness="0" Padding="16,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="+ Thêm Nhà Cung Cấp" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2 Cột: Bảng dữ liệu NCC & Form thêm/sửa -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Bảng danh sách Nhà cung cấp -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Danh Sách Nhà Cung Cấp Đối Tác" FontWeight="Bold" FontSize="15" Foreground="#1E293B"/>
                        <TextBlock x:Name="lblCount" Text="0 đối tác" HorizontalAlignment="Right" Foreground="#64748B" FontSize="12"/>
                    </Grid>

                    <DataGrid x:Name="dgSuppliers" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" RowHeight="44"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              BorderThickness="0" Background="Transparent"
                              SelectionChanged="DgSuppliers_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Width="45" Binding="{Binding SupplierId}"/>
                            <DataGridTextColumn Header="Tên Nhà Cung Cấp" Width="180" Binding="{Binding SupplierName}" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Người Liên Hệ" Width="130" Binding="{Binding ContactName}"/>
                            <DataGridTextColumn Header="Điện Thoại" Width="110" Binding="{Binding PhoneNumber}"/>
                            <DataGridTextColumn Header="Địa Chỉ" Width="*" Binding="{Binding Address}"/>
                            <DataGridTextColumn Header="Lượt Giao" Width="75" Binding="{Binding TotalReceipts}" FontWeight="SemiBold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Cột phải: Form Thêm / Cập nhật Nhà Cung Cấp -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="18">
                <StackPanel>
                    <TextBlock x:Name="lblFormTitle" Text="THÊM MỚI NHÀ CUNG CẤP" FontWeight="Bold" FontSize="15" Foreground="#1E293B" Margin="0,0,0,14"/>

                    <TextBlock Text="Tên nhà cung cấp / Công ty: *" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtSupplierName" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Text="Người đại diện liên hệ:" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtContactName" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Text="Số điện thoại liên lạc:" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtPhoneNumber" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Text="Hộp thư điện tử (Email):" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtEmail" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Text="Địa chỉ kho / Trụ sở chính:" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtAddress" Height="55" TextWrapping="Wrap" AcceptsReturn="True" Padding="8" Margin="0,0,0,20"/>

                    <Button Click="BtnSave_Click" Height="42" Background="#2563EB" Foreground="White" BorderThickness="0" Margin="0,0,0,10" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock x:Name="btnSaveText" Text="LƯU NHÀ CUNG CẤP" FontWeight="Bold"/>
                    </Button>

                    <Button x:Name="btnDelete" Click="BtnDelete_Click" Height="36" Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Margin="0,0,0,10" Visibility="Collapsed" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="Ngưng Hoạt Động NCC Này" FontWeight="SemiBold"/>
                    </Button>

                    <Button Click="BtnCancel_Click" Height="36" Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="Hủy Bỏ / Làm Mới Form"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

