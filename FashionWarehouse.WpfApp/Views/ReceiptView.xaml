<UserControl x:Class="FashionWarehouse.WpfApp.Views.ReceiptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1050"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Khung quét súng Barcode -->
        <Border Grid.Row="0" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="CHẾ ĐỘ SÚNG BẮN MÃ VẠCH" FontWeight="Bold" Foreground="#92400E" FontSize="13"/>
                    <TextBlock Text="Bắn mã vào ô bên cạnh để thêm hàng" Foreground="#B45309" FontSize="11"/>
                </StackPanel>

                <TextBox Name="txtBarcode" Grid.Column="1" Height="40" FontSize="15" FontWeight="Bold" FontFamily="Consolas"
                         KeyDown="TxtBarcode_KeyDown"
                         VerticalContentAlignment="Center" Padding="10,0"/>

                <Button Grid.Column="2" Click="BtnAddBarcode_Click" Height="40" Margin="10,0,0,0" Background="#D97706" Foreground="White" BorderThickness="0" Padding="14,0" Cursor="Hand">
                    <TextBlock Text="+ Thêm dòng" FontWeight="SemiBold"/>
                </Button>
            </Grid>
        </Border>

        <!-- 2 Cột: Bảng hàng hóa & Thông tin phiếu -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Bảng hàng hóa -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Danh Sách Mặt Hàng Trong Phiếu" FontWeight="Bold" FontSize="16" Foreground="#1E293B" Margin="0,0,0,12"/>

                    <DataGrid Grid.Row="1" Name="dgReceiptItems" AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              HeadersVisibility="Column" RowHeight="42" BorderThickness="0" Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Width="50" Binding="{Binding Index}"/>
                            <DataGridTextColumn Header="Mã SKU" Width="130" Binding="{Binding SKU}" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Tên Hàng / Quy cách" Width="*" Binding="{Binding DisplayName}"/>
                            <DataGridTextColumn Header="Vị trí kệ" Width="90" Binding="{Binding LocationCode}"/>
                            <DataGridTextColumn Header="Số lượng" Width="80" Binding="{Binding Quantity}" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Đơn giá" Width="100" Binding="{Binding UnitPrice, StringFormat={}{0:N0} đ}"/>
                            <DataGridTextColumn Header="Thành tiền" Width="120" Binding="{Binding TotalLineAmount, StringFormat={}{0:N0} đ}" FontWeight="SemiBold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Cột phải: Thông tin phiếu & Nút chốt -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="18">
                <StackPanel>
                    <TextBlock Text="Thông Tin Phiếu Giao Dịch" FontWeight="Bold" FontSize="16" Foreground="#1E293B" Margin="0,0,0,14"/>

                    <TextBlock Text="Loại Giao Dịch:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <RadioButton Content="Nhập Kho" IsChecked="True" Margin="0,0,18,0" FontWeight="SemiBold" Foreground="#10B981"/>
                        <RadioButton Content="Xuất Kho" FontWeight="SemiBold" Foreground="#EF4444"/>
                    </StackPanel>

                    <TextBlock Text="Mã phiếu:" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox Text="PN-20261014-001" IsReadOnly="True" Height="34" Padding="6" Margin="0,0,0,12"/>

                    <TextBlock Text="Nhà cung cấp / Đối tác:" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox Height="34" SelectedIndex="0" Margin="0,0,0,12">
                        <ComboBoxItem Content="Công Ty May Mặc Việt Tiến"/>
                        <ComboBoxItem Content="Tổng Công Ty Đức Giang"/>
                    </ComboBox>

                    <TextBlock Text="Ghi chú chứng từ:" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox Height="34" Padding="6" Margin="0,0,0,18"/>

                    <Border Background="#F8FAFC" CornerRadius="6" Padding="12" Margin="0,0,0,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Tổng số lượng:" Foreground="#64748B"/>
                                <TextBlock Name="txtTotalQty" Text="90 Cái" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Tổng tiền phiếu:" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock Name="txtTotalAmount" Text="10,800,000 đ" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right" Foreground="#2563EB"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Click="BtnCommit_Click" Height="44" Background="#10B981" Foreground="White" BorderThickness="0" Margin="0,0,0,8" Cursor="Hand">
                        <TextBlock Text="LƯU &amp; HOÀN TẤT PHIẾU" FontWeight="Bold"/>
                    </Button>

                    <Button Height="36" Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Cursor="Hand">
                        <TextBlock Text="Hủy bỏ"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
