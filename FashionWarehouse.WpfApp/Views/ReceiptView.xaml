<UserControl x:Class="FashionWarehouse.WpfApp.Views.ReceiptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1050"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Khung nhập liệu: Hỗ trợ cả gõ/bắn Barcode lẫn Tìm kiếm theo Tên/SKU -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Hàng 1: 2 chế độ chọn hàng -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cách 1: Chọn từ danh mục / ComboBox (Không cần nhớ mã) -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CÁCH 1: CHỌN MẶT HÀNG TỪ DANH MỤC KHO" FontWeight="Bold" Foreground="#2563EB" FontSize="12" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Name="cboProductPicker" Height="38" VerticalContentAlignment="Center" Margin="0,0,8,0" SelectedIndex="0"/>
                            <Button Grid.Column="1" Click="BtnAddFromPicker_Click" Height="38" Background="#2563EB" Foreground="White" BorderThickness="0" Padding="14,0" Cursor="Hand">
                                <TextBlock Text="+ Thêm hàng" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Cách 2: Gõ mã Barcode / SKU bằng phím (hoặc súng bắn nếu có) -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="CÁCH 2: NHẬP TRỰC TIẾP BARCODE HOẶC SKU (BẤM ENTER)" FontWeight="Bold" Foreground="#D97706" FontSize="12" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="txtBarcode" Height="38" FontSize="14" FontWeight="Bold" FontFamily="Consolas"
                                     KeyDown="TxtBarcode_KeyDown"
                                     VerticalContentAlignment="Center" Padding="10,0"/>
                            <Button Grid.Column="1" Click="BtnAddBarcode_Click" Height="38" Margin="8,0,0,0" Background="#F59E0B" Foreground="White" BorderThickness="0" Padding="14,0" Cursor="Hand">
                                <TextBlock Text="Quét / Nhận" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Hàng 2: Các nút bấm chọn nhanh + Nút kết nối điện thoại -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Chọn nhanh mẫu test: " FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Click="BtnQuickAdd_Click" Tag="893600100101" Content="Áo Polo Đen (M)" Background="#F1F5F9" Foreground="#1E293B" BorderThickness="0" Padding="8,4" Margin="0,0,6,0" Cursor="Hand" FontSize="11"/>
                        <Button Click="BtnQuickAdd_Click" Tag="893600100102" Content="Áo Polo Đen (L)" Background="#F1F5F9" Foreground="#1E293B" BorderThickness="0" Padding="8,4" Margin="0,0,6,0" Cursor="Hand" FontSize="11"/>
                        <Button Click="BtnQuickAdd_Click" Tag="893600100103" Content="Áo Polo Trắng (M)" Background="#F1F5F9" Foreground="#1E293B" BorderThickness="0" Padding="8,4" Margin="0,0,6,0" Cursor="Hand" FontSize="11"/>
                        <Button Click="BtnQuickAdd_Click" Tag="893600100104" Content="Áo Polo Trắng (L)" Background="#F1F5F9" Foreground="#1E293B" BorderThickness="0" Padding="8,4" Margin="0,0,6,0" Cursor="Hand" FontSize="11"/>
                    </WrapPanel>

                    <!-- Nút mở hướng dẫn quét bằng điện thoại -->
                    <Button Grid.Column="1" Click="BtnMobileScan_Click" Background="#8B5CF6" Foreground="White" BorderThickness="0" Padding="12,5" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📱 Quét bằng Camera Điện thoại" FontWeight="Bold" FontSize="12"/>
                            <Border Name="brdSignalRStatus" Width="8" Height="8" CornerRadius="4" Background="#EF4444" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Trạng thái kết nối Realtime"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Panel thông tin mặt hàng vừa chọn (Visual Feedback) -->
        <Border x:Name="pnlScannedInfo" Grid.Row="1" Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="✓" FontSize="18" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Đã thêm: " Foreground="#065F46" FontWeight="SemiBold"/>
                    <TextBlock x:Name="lblScannedSku" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,16,0"/>
                    <TextBlock Text="Sản phẩm: " Foreground="#065F46" FontWeight="SemiBold"/>
                    <TextBlock x:Name="lblScannedName" Foreground="#1E293B" Margin="0,0,16,0"/>
                    <TextBlock Text="Tồn hiện tại: " Foreground="#065F46" FontWeight="SemiBold"/>
                    <TextBlock x:Name="lblScannedStock" FontWeight="Bold" Margin="0,0,16,0"/>
                    <TextBlock Text="Vị trí kệ: " Foreground="#065F46" FontWeight="SemiBold"/>
                    <TextBlock x:Name="lblScannedLoc" Foreground="#1E293B"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 2 Cột: Bảng hàng hóa & Thông tin phiếu -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Bảng hàng hóa -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="lblTableTitle" Grid.Column="0" Text="Danh Sách Hàng Hóa Nhập Vào Kho (Theo Giá Vốn)" FontWeight="Bold" FontSize="15" Foreground="#1E293B" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="(Double-click dòng để xóa | Click nút để sửa số lượng)" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    </Grid>

                    <DataGrid Grid.Row="1" Name="dgReceiptItems" AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              HeadersVisibility="Column" RowHeight="42" BorderThickness="0" Background="Transparent"
                              MouseDoubleClick="DgReceiptItems_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Width="45" Binding="{Binding Index}"/>
                            <DataGridTextColumn Header="Mã Barcode" Width="110" Binding="{Binding Barcode}"/>
                            <DataGridTextColumn Header="Mã SKU" Width="125" Binding="{Binding SKU}" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Tên Hàng / Quy cách" Width="*" Binding="{Binding DisplayName}"/>
                            <DataGridTextColumn Header="Vị trí" Width="75" Binding="{Binding LocationCode}"/>
                            <DataGridTextColumn Header="Số lượng" Width="70" Binding="{Binding Quantity}" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Đơn giá" Width="95" Binding="{Binding UnitPrice, StringFormat={}{0:N0} đ}"/>
                            <DataGridTextColumn Header="Thành tiền" Width="110" Binding="{Binding TotalLineAmount, StringFormat={}{0:N0} đ}" FontWeight="SemiBold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Cột phải: Thông tin phiếu & Nút chốt -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="18">
                <StackPanel>
                    <!-- Badge phân biệt ngữ cảnh rõ ràng giữa Nhập kho & Xuất kho -->
                    <Border x:Name="brdTransactionModeBadge" Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="lblModeIcon" Text="📥" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="lblModeTitle" Text="PHIẾU NHẬP HÀNG TỪ NCC" FontWeight="Bold" FontSize="13" Foreground="#047857" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="lblModeDesc" Text="Nhập hàng may mặc vào kho &amp; ghi nhận giá vốn" FontSize="11" Foreground="#065F46" Margin="24,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Radio button ẩn để giữ tương thích logic code -->
                    <StackPanel x:Name="pnlRadioType" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton Name="rdoImport" Content="Nhập Kho" IsChecked="True" Checked="TransactionType_Changed"/>
                        <RadioButton Name="rdoExport" Content="Xuất Kho" Checked="TransactionType_Changed"/>
                    </StackPanel>
                    <TextBox Name="txtReceiptCode" Height="34" Padding="6" Margin="0,0,0,12"/>

                    <TextBlock x:Name="lblPartnerHeader" Text="Nhà cung cấp:" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox Name="cboPartner" Height="34" Margin="0,0,0,12"/>

                    <TextBlock Text="Ghi chú chứng từ:" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox Name="txtNotes" Height="45" TextWrapping="Wrap" AcceptsReturn="True" Padding="6" Margin="0,0,0,16"/>

                    <Border Background="#F8FAFC" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Tổng số lượng:" Foreground="#64748B"/>
                                <TextBlock Name="txtTotalQty" Text="0 Cái" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Tổng tiền phiếu:" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock Name="txtTotalAmount" Text="0 đ" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right" Foreground="#2563EB"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button x:Name="btnCommit" Click="BtnCommit_Click" Height="44" Background="#10B981" Foreground="White" BorderThickness="0" Margin="0,0,0,8" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock x:Name="btnCommitText" Text="✅ HOÀN TẤT NHẬP KHO (IN PHIẾU)" FontWeight="Bold"/>
                    </Button>

                    <Button Click="BtnViewCurrentInvoice_Click" Height="36" Background="#EEF2FF" Foreground="#4F46E5" BorderThickness="0" Margin="0,0,0,8" Cursor="Hand">
                        <TextBlock Text="🧾 Xem Hóa Đơn / Phiếu Chứng Từ" FontWeight="SemiBold"/>
                    </Button>

                    <Button Click="BtnReset_Click" Height="36" Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Cursor="Hand">
                        <TextBlock Text="Xóa Trắng &amp; Tạo Phiếu Mới"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
