<UserControl x:Class="FashionWarehouse.WpfApp.Views.WarehouseLocationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. KPI Cards -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Tổng kho -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TỔNG SỐ KHO &amp; VỊ TRÍ KỆ" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="txtKpiTotal" Text="0" FontSize="26" FontWeight="Bold" Foreground="#1E293B" Margin="0,6,0,2"/>
                    <TextBlock Text="Điểm lưu trữ trong hệ thống" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Tổng SKU -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="4,0,8,0">
                <StackPanel>
                    <TextBlock Text="MẶT HÀNG (SKU) ĐANG LƯU" FontSize="11" FontWeight="Bold" Foreground="#2563EB"/>
                    <TextBlock x:Name="txtKpiSkus" Text="0" FontSize="26" FontWeight="Bold" Foreground="#3B82F6" Margin="0,6,0,2"/>
                    <TextBlock Text="Số mã biến thể có tồn hàng" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Tổng sản phẩm -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16" Margin="4,0,8,0">
                <StackPanel>
                    <TextBlock Text="TỔNG CHIẾC TỒN KHO" FontSize="11" FontWeight="Bold" Foreground="#059669"/>
                    <TextBlock x:Name="txtKpiTotalQty" Text="0" FontSize="26" FontWeight="Bold" Foreground="#10B981" Margin="0,6,0,2"/>
                    <TextBlock Text="Tổng sản phẩm trên toàn kho" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Kệ còn trống -->
            <Border Grid.Column="3" Background="White" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="VỊ TRÍ KỆ TRỐNG" FontSize="11" FontWeight="Bold" Foreground="#D97706"/>
                    <TextBlock x:Name="txtKpiEmpty" Text="0" FontSize="26" FontWeight="Bold" Foreground="#F59E0B" Margin="0,6,0,2"/>
                    <TextBlock Text="Sẵn sàng nhập hàng mới" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Action & Filter Bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Grid Grid.Column="0">
                    <TextBox x:Name="txtSearch" Height="38" Padding="10,0" VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_TextChanged"/>
                    <TextBlock Text="🔍 Tìm theo mã kho, tên vị trí kệ..." Foreground="#94A3B8"
                               VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <TextBlock x:Name="lblStatusMessage" Grid.Column="1" VerticalAlignment="Center" Margin="20,0"
                           FontWeight="SemiBold" FontSize="12" Foreground="#059669"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Click="BtnRefresh_Click" Height="38" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" Padding="14,0" Margin="0,0,10,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="🔄 Làm Mới"/>
                    </Button>

                    <Button Click="BtnOpenTransferModal_Click" Height="38" Background="#8B5CF6" Foreground="White" BorderThickness="0" Padding="14,0" Margin="0,0,10,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="⇄ Điều Chuyển Hàng" FontWeight="Bold"/>
                    </Button>

                    <Button Click="BtnNewLocation_Click" Height="38" Background="#2563EB" Foreground="White" BorderThickness="0" Padding="16,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="+ Thêm Kho / Vị Trí Kệ" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Main Content: Table + Side Panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="colSidePanel" Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Table danh sách kho -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="DANH SÁCH CÁC KHO &amp; KHU VỰC LƯU TRỮ" FontWeight="Bold" FontSize="15" Foreground="#1E293B" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="(Click để xem chi tiết / Click nút để thao tác)" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="dgLocations" AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              HeadersVisibility="Column" RowHeight="46" BorderThickness="0" Background="Transparent"
                              SelectionMode="Single" SelectionChanged="DgLocations_SelectionChanged"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã Vị Trí" Width="105" Binding="{Binding LocationCode}" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Tên Kho / Kệ" Width="145" Binding="{Binding LocationName}"/>
                            <DataGridTextColumn Header="Mô Tả Lưu Trữ" Width="*" MinWidth="150" Binding="{Binding Description}"/>

                            <DataGridTemplateColumn Header="Số SKU" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SkuCount}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Tổng Tồn" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalQuantity, StringFormat={}{0:N0}}" FontWeight="Bold" FontSize="13" Foreground="#2563EB"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Thao tác" Width="165">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Content="📦 Xem Hàng" Click="BtnViewInventory_Click" Tag="{Binding}"
                                                    Background="#DBEAFE" Foreground="#1E40AF" BorderThickness="0"
                                                    Padding="8,4" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <Button Content="✏️" Click="BtnEdit_Click" Tag="{Binding}"
                                                    Background="#F1F5F9" Foreground="#334155" BorderThickness="0"
                                                    Padding="6,4" FontSize="11" Margin="0,0,6,0" Cursor="Hand" ToolTip="Sửa thông tin">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <Button Content="🗑️" Click="BtnDelete_Click" Tag="{Binding}"
                                                    Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0"
                                                    Padding="6,4" FontSize="11" Cursor="Hand" ToolTip="Xóa kho (khi tồn = 0)">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Side Panel: Form Thêm/Sửa Kho HOẶC Bảng hàng hóa trên kệ -->
            <Border x:Name="brdSidePanel" Grid.Column="1" Width="400" Margin="14,0,0,0" Background="White" CornerRadius="8" Padding="18" Visibility="Collapsed">
                <Grid>
                <!-- Chế độ 1: Form Thêm / Chỉnh sửa -->
                <Grid x:Name="pnlEditForm" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock x:Name="lblFormTitle" Text="THÊM VỊ TRÍ KHO MỚI" FontWeight="Bold" FontSize="15" Foreground="#1E293B"/>
                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Width="28" Height="28" Content="✕" Click="BtnCancelEdit_Click" ToolTip="Đóng phần thêm / sửa vị trí kho" Background="#F1F5F9" BorderThickness="0" Foreground="#64748B" FontSize="13" FontWeight="Bold" Cursor="Hand"><Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources></Button>

                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Mã Vị Trí / Kệ:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtLocationCode" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="(Để trống hệ thống sẽ tự sinh mã tự động KHO-X-XX)" FontSize="11" Foreground="#94A3B8" Margin="0,-8,0,12"/>

                            <TextBlock Text="Tên Kho / Vị Trí Kệ (*):" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtLocationName" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                            <TextBlock Text="Mô Tả / Đặc Điểm Lưu Trữ:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtDescription" Height="80" Padding="8" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>

                            <!-- Thông tin thống kê của kho nếu đang chỉnh sửa -->
                            <Border x:Name="pnlLocationStats" Background="#F8FAFC" CornerRadius="6" Padding="12" Margin="0,0,0,16" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="THÔNG TIN TỒN TRỮ HIỆN TẠI" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Số mã SKU đang có:" FontSize="12" Foreground="#475569"/>
                                        <TextBlock x:Name="txtStatSkus" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#1E293B"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Tổng chiếc tồn kho:" FontSize="12" Foreground="#475569"/>
                                        <TextBlock x:Name="txtStatTotalQty" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#059669"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Click="BtnCancelEdit_Click" Content="Hủy bỏ" Height="36" Width="90"
                                Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Click="BtnSaveLocation_Click" Height="36" Width="130"
                                Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock x:Name="lblSaveBtnText" Text="💾 Lưu Thông Tin" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Chế độ 2: Danh sách hàng hóa chi tiết đang nằm trong kho -->
                <Grid x:Name="pnlInventoryList" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="lblInventoryTitle" Text="HÀNG HÓA TẠI KỆ KHO-A-01" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                            <TextBlock x:Name="lblInventorySubTitle" Text="Chi tiết các sản phẩm đang có số lượng tồn > 0" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="✕ Đóng" Click="BtnCloseInventory_Click"
                                Background="#F1F5F9" BorderThickness="0" Foreground="#475569" Padding="8,4" FontSize="11" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </DockPanel>

                    <DataGrid Grid.Row="1" x:Name="dgLocationItems" AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              HeadersVisibility="Column" RowHeight="36" BorderThickness="0" Background="Transparent"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã SKU" Width="100" Binding="{Binding SKU}" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Tên Hàng / Quy cách" Width="*" Binding="{Binding ProductName}"/>
                            <DataGridTextColumn Header="Màu" Width="60" Binding="{Binding ColorName}"/>
                            <DataGridTextColumn Header="Size" Width="45" Binding="{Binding SizeName}"/>
                            <DataGridTextColumn Header="SL Tồn" Width="65" Binding="{Binding QuantityOnHand}" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2" Click="BtnTransferCurrentLoc_Click" Margin="0,12,0,0" Height="36"
                            Background="#8B5CF6" Foreground="White" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="⇄ Điều chuyển hàng từ vị trí này" FontWeight="Bold"/>
                    </Button>
                </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. DIALOG / MODAL ĐIỀU CHUYỂN HÀNG NỘI BỘ GIỮA CÁC KHO -->
        <Grid x:Name="dlgTransfer" Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed">
            <Border Background="White" CornerRadius="10" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="ĐIỀU CHUYỂN HÀNG HÓA NỘI BỘ (TRANSFER)" FontWeight="Bold" FontSize="15" Foreground="#1E293B"/>
                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="✕" Click="BtnCloseTransferDialog_Click"
                                Background="Transparent" BorderThickness="0" Foreground="#94A3B8" FontSize="14" Cursor="Hand"/>
                    </DockPanel>

                    <!-- Kho Nguồn -->
                    <TextBlock Text="Vị trí kho chuyển đi (Kho Nguồn) (*):" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cboFromLocation" Height="36" SelectionChanged="CboFromLocation_SelectionChanged" Margin="0,0,0,12"/>

                    <!-- Mặt hàng SKU -->
                    <TextBlock Text="Mặt hàng cần chuyển (*):" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cboTransferVariant" Height="36" SelectionChanged="CboTransferVariant_SelectionChanged" Margin="0,0,0,4"/>
                    <TextBlock x:Name="lblStockAvailable" Text="Chọn kho và mặt hàng để kiểm tra số lượng tồn khả dụng" FontSize="11" Foreground="#059669" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <!-- Kho Đích -->
                    <TextBlock Text="Vị trí kho tiếp nhận (Kho Đích) (*):" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cboToLocation" Height="36" Margin="0,0,0,12"/>

                    <!-- Số lượng -->
                    <TextBlock Text="Số lượng chuyển (chiếc) (*):" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtTransferQty" Height="36" Text="1" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <!-- Ghi chú lý do -->
                    <TextBlock Text="Ghi chú lý do điều chuyển:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtTransferNotes" Height="50" Padding="8" TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="BtnCloseTransferDialog_Click" Content="Đóng" Height="36" Width="90"
                                Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Click="BtnExecuteTransfer_Click" Height="36" Width="140"
                                Background="#8B5CF6" Foreground="White" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="⇄ Thực Hiện Chuyển" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
