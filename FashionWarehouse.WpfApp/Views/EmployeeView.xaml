<UserControl x:Class="FashionWarehouse.WpfApp.Views.EmployeeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" Background="#F8FAFC">
    <Grid Margin="4,0,4,0">
        <!-- Main Layout -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Permission Warning Banner (if non-admin) -->
                <RowDefinition Height="Auto"/>
                <!-- 1: KPI Stats Cards -->
                <RowDefinition Height="Auto"/>
                <!-- 2: Filter & Action Bar -->
                <RowDefinition Height="Auto"/>
                <!-- 3: DataGrid Table -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 0: Permission Notice Banner -->
            <Border x:Name="brdPermissionWarning" Grid.Row="0" Visibility="Collapsed"
                    Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="txtPermissionWarning" VerticalAlignment="Center"
                               Text="Chế độ chỉ xem: Bạn đang đăng nhập với quyền Thủ kho. Chỉ Quản trị viên (Admin) mới có quyền tạo mới, phân quyền, đổi mật khẩu hoặc khóa tài khoản."
                               Foreground="#92400E" FontSize="12" FontWeight="SemiBold"/>
                </DockPanel>
            </Border>

            <!-- 1: KPI STATS CARDS -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Tổng nhân viên -->
                <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TỔNG SỐ TÀI KHOẢN" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="txtTotalUsers" Text="0" FontSize="24" FontWeight="ExtraBold" Foreground="#2563EB" Margin="0,6,0,2"/>
                        <TextBlock Text="Nhân sự vận hành hệ thống" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Đang hoạt động -->
                <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="ĐANG HOẠT ĐỘNG" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="txtActiveUsers" Text="0" FontSize="24" FontWeight="ExtraBold" Foreground="#10B981" Margin="0,6,0,2"/>
                        <TextBlock Text="Có quyền đăng nhập làm việc" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Đã khóa -->
                <Border Grid.Column="4" Background="White" CornerRadius="10" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="BỊ TẠM KHÓA" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="txtLockedUsers" Text="0" FontSize="24" FontWeight="ExtraBold" Foreground="#EF4444" Margin="0,6,0,2"/>
                        <TextBlock Text="Bị vô hiệu hóa truy cập" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: Cơ cấu quyền hạn -->
                <Border Grid.Column="6" Background="White" CornerRadius="10" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="CƠ CẤU VAI TRÒ" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="txtRoleStats" Text="0 Admin • 0 Thủ kho" FontSize="16" FontWeight="Bold" Foreground="#7C3AED" Margin="0,10,0,4"/>
                        <TextBlock Text="Tỷ lệ phân quyền nhân viên" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2: FILTER & ACTION TOOLBAR (WrapPanel responsive) -->
            <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="12,10" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                <WrapPanel VerticalAlignment="Center">
                    <!-- Search Box -->
                    <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="#F8FAFC"
                            Width="210" Height="36" Padding="8,0" Margin="0,0,8,6">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#94A3B8" Margin="0,0,4,0"/>
                            <TextBox x:Name="txtSearch" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" FontSize="12" TextChanged="TxtSearch_TextChanged"/>
                        </Grid>
                    </Border>

                    <!-- Role Filter -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,6" VerticalAlignment="Center">
                        <TextBlock Text="Chức vụ:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#475569" FontSize="11.5"/>
                        <ComboBox x:Name="cmbRoleFilter" Width="145" Height="36" VerticalContentAlignment="Center" FontSize="11.5"
                                  SelectionChanged="CmbFilter_SelectionChanged">
                            <ComboBoxItem Content="Tất cả chức vụ" IsSelected="True"/>
                            <ComboBoxItem Content="👑 Quản trị viên (Admin)"/>
                            <ComboBoxItem Content="📦 Thủ kho (WarehouseKeeper)"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Status Filter -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,6" VerticalAlignment="Center">
                        <TextBlock Text="Trạng thái:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#475569" FontSize="11.5"/>
                        <ComboBox x:Name="cmbStatusFilter" Width="130" Height="36" VerticalContentAlignment="Center" FontSize="11.5"
                                  SelectionChanged="CmbFilter_SelectionChanged">
                            <ComboBoxItem Content="Tất cả trạng thái" IsSelected="True"/>
                            <ComboBoxItem Content="🟢 Đang hoạt động"/>
                            <ComboBoxItem Content="🔒 Đã tạm khóa"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Refresh Button -->
                    <Button Content="🔄 Làm mới" Height="36" Padding="10,0" Margin="0,0,8,6" Background="#F1F5F9"
                            Foreground="#334155" BorderBrush="#CBD5E1" Cursor="Hand" Click="BtnRefresh_Click"/>

                    <!-- Role Permission Matrix Button -->
                    <Button Content="🛡️ Ma trận phân quyền" Height="36" Padding="12,0" Margin="0,0,8,6"
                            Background="#EDE9FE" Foreground="#6D28D9" FontWeight="Bold" BorderBrush="#C4B5FD"
                            Cursor="Hand" Click="BtnShowPermissionMatrix_Click"/>

                    <!-- Add Employee Button -->
                    <Button x:Name="btnAddEmployee" Content="+ Thêm nhân viên mới" Height="36" Padding="14,0" Margin="0,0,0,6"
                            Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0"
                            Cursor="Hand" Click="BtnAddEmployee_Click"/>
                </WrapPanel>
            </Border>

            <!-- 3: EMPLOYEES DATAGRID -->
            <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="DANH SÁCH NHÂN SỰ &amp; TÀI KHOẢN HỆ THỐNG"
                                   FontWeight="Bold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtListSummary" DockPanel.Dock="Right" Text="Hiển thị 0 nhân sự"
                                   FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                    </DockPanel>

                    <DataGrid x:Name="dgEmployees" Grid.Row="1" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              Background="White" BorderThickness="0" RowHeight="52"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Height" Value="40"/>
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Avatar / Initials -->
                            <DataGridTemplateColumn Header="AVATAR" Width="46">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="32" Height="32" CornerRadius="16"
                                                Background="{Binding AvatarBg}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initials}" Foreground="{Binding AvatarFg}"
                                                       FontWeight="Bold" FontSize="10.5"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Username -->
                            <DataGridTemplateColumn Header="TÊN ĐĂNG NHẬP" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="4,0">
                                            <TextBlock Text="{Binding Username}" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding UserCodeTag}" FontSize="9.5" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Full Name -->
                            <DataGridTemplateColumn Header="HỌ VÀ TÊN" Width="1.1*" MinWidth="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="11.5"
                                                   Foreground="#1E293B" VerticalAlignment="Center" Margin="4,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Role Badge -->
                            <DataGridTemplateColumn Header="CHỨC VỤ / PHÂN QUYỀN" Width="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding RoleBadgeBg}" CornerRadius="12"
                                                Padding="7,2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0"
                                                ToolTip="{Binding RoleName}">
                                            <TextBlock Text="{Binding RoleBadgeText}" Foreground="{Binding RoleBadgeFg}"
                                                       FontWeight="Bold" FontSize="10.5"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Contact (Email + Phone) -->
                            <DataGridTemplateColumn Header="LIÊN HỆ" Width="*" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="4,0">
                                            <TextBlock Text="{Binding EmailDisplay}" FontSize="10.5" Foreground="#334155" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding PhoneDisplay}" FontSize="10" Foreground="#64748B"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Receipts handled -->
                            <DataGridTemplateColumn Header="SỐ PHIẾU" Width="65">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ReceiptsDisplay}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status Pill -->
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBadgeBg}" CornerRadius="12"
                                                Padding="7,2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0">
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBadgeFg}"
                                                       FontWeight="SemiBold" FontSize="10.5"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Created Date -->
                            <DataGridTemplateColumn Header="NGÀY TẠO" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CreatedDateDisplay}" FontSize="10.5" Foreground="#64748B"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="THAO TÁC" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <!-- Edit -->
                                            <Button Content="✏️ Sửa" Margin="0,0,3,0" Padding="6,3"
                                                    Background="#EFF6FF" Foreground="#1D4ED8" BorderThickness="0"
                                                    FontWeight="SemiBold" FontSize="10.5" Cursor="Hand"
                                                    IsEnabled="{Binding CanManage}"
                                                    Click="BtnRowEdit_Click" Tag="{Binding}">
                                                <Button.Resources>
                                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                                </Button.Resources>
                                            </Button>

                                            <!-- Reset Password -->
                                            <Button Content="🔑 Đổi MK" Margin="0,0,3,0" Padding="6,3"
                                                    Background="#FEF3C7" Foreground="#B45309" BorderThickness="0"
                                                    FontWeight="SemiBold" FontSize="10.5" Cursor="Hand"
                                                    IsEnabled="{Binding CanManage}"
                                                    Click="BtnRowResetPassword_Click" Tag="{Binding}">
                                                <Button.Resources>
                                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                                </Button.Resources>
                                            </Button>

                                            <!-- Lock / Unlock Toggle -->
                                            <Button Content="{Binding LockActionText}" Padding="6,3"
                                                    Background="#F8FAFC" Foreground="{Binding LockActionFg}" BorderBrush="#CBD5E1"
                                                    FontWeight="SemiBold" FontSize="10.5" Cursor="Hand"
                                                    IsEnabled="{Binding CanToggleLock}"
                                                    Click="BtnRowToggleLock_Click" Tag="{Binding}">
                                                <Button.Resources>
                                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== MODAL 1: ADD / EDIT EMPLOYEE ==================== -->
        <Grid x:Name="pnlUserModal" Visibility="Collapsed" Background="#80000000">
            <Border Width="480" Background="White" CornerRadius="12" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Modal Header -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock x:Name="txtModalTitle" Text="+ Thêm Nhân Viên Mới" FontWeight="Bold" FontSize="16" Foreground="#0F172A"/>
                            <TextBlock x:Name="txtModalSubtitle" Text="Điền thông tin tài khoản và thiết lập quyền truy cập hệ thống" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Width="30" Height="30"
                                Background="Transparent" Foreground="#64748B" FontSize="14" FontWeight="Bold"
                                BorderThickness="0" Cursor="Hand" Click="BtnCloseUserModal_Click"/>
                    </DockPanel>

                    <!-- Error Banner -->
                    <Border x:Name="brdModalError" Visibility="Collapsed" Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1"
                            CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                        <TextBlock x:Name="txtModalError" Text="Lỗi" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Họ và tên -->
                    <TextBlock Text="Họ và tên nhân viên *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="#F8FAFC" Padding="10,0" Margin="0,0,0,12">
                        <TextBox x:Name="txtModalFullName" Height="34" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="13"/>
                    </Border>

                    <!-- Tên đăng nhập -->
                    <TextBlock Text="Tên đăng nhập (Username) *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="#F8FAFC" Padding="10,0" Margin="0,0,0,12">
                        <TextBox x:Name="txtModalUsername" Height="34" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="13"/>
                    </Border>

                    <!-- Mật khẩu khởi tạo (Chỉ hiện khi tạo mới) -->
                    <StackPanel x:Name="pnlPasswordSection">
                        <TextBlock Text="Mật khẩu khởi tạo (Tối thiểu 6 ký tự) *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="#F8FAFC" Padding="10,0" Margin="0,0,0,12">
                            <PasswordBox x:Name="txtModalPassword" Height="34" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="13"/>
                        </Border>
                    </StackPanel>

                    <!-- Chức vụ / Vai trò -->
                    <TextBlock Text="Chức vụ / Phân quyền *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbModalRole" Height="36" VerticalContentAlignment="Center" Margin="0,0,0,12">
                        <ComboBoxItem Content="👑 Quản trị viên (Admin) - Toàn quyền quản trị" Tag="1"/>
                        <ComboBoxItem Content="📦 Thủ kho (WarehouseKeeper) - Quản lý xuất nhập tồn" Tag="2" IsSelected="True"/>
                    </ComboBox>

                    <!-- Email & SĐT -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Email -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Email" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="#F8FAFC" Padding="10,0">
                                <TextBox x:Name="txtModalEmail" Height="34" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="12"/>
                            </Border>
                        </StackPanel>

                        <!-- Phone -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Số điện thoại" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="#F8FAFC" Padding="10,0">
                                <TextBox x:Name="txtModalPhone" Height="34" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="12"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Checkbox Trạng thái -->
                    <CheckBox x:Name="chkModalActive" Content="Kích hoạt tài khoản ngay (Cho phép đăng nhập hệ thống)"
                              IsChecked="True" FontSize="12" Foreground="#334155" Margin="0,0,0,20"/>

                    <!-- Modal Actions -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="✕ Hủy bỏ" Height="40" Background="#F1F5F9"
                                Foreground="#475569" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnCloseUserModal_Click"/>
                        <Button Grid.Column="2" x:Name="btnSaveUser" Content="💾 Lưu Nhân Viên" Height="40" Background="#2563EB"
                                Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnSaveUser_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== MODAL 2: RESET PASSWORD ==================== -->
        <Grid x:Name="pnlResetPasswordModal" Visibility="Collapsed" Background="#80000000">
            <Border Width="430" Background="White" CornerRadius="12" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="🔑 Đặt Lại Mật Khẩu" FontWeight="Bold" FontSize="16" Foreground="#0F172A"/>
                            <TextBlock x:Name="txtResetTargetUser" Text="Nhân viên: Admin (admin)" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Width="30" Height="30"
                                Background="Transparent" Foreground="#64748B" FontSize="14" FontWeight="Bold"
                                BorderThickness="0" Cursor="Hand" Click="BtnCloseResetModal_Click"/>
                    </DockPanel>

                    <!-- Error Banner -->
                    <Border x:Name="brdResetError" Visibility="Collapsed" Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1"
                            CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                        <TextBlock x:Name="txtResetError" Text="Lỗi" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Mật khẩu mới -->
                    <TextBlock Text="Mật khẩu mới (Tối thiểu 6 ký tự) *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="#F8FAFC" Padding="10,0" Margin="0,0,0,10">
                        <TextBox x:Name="txtNewPassword" Height="34" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="13"/>
                    </Border>

                    <!-- Quick password generator -->
                    <Button Content="🎲 Tạo mật khẩu nhanh (FwPass@2026)" Height="30" Padding="10,0"
                            Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE"
                            FontSize="11" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,0,18"
                            Click="BtnGeneratePassword_Click"/>

                    <!-- Modal Actions -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="✕ Đóng" Height="40" Background="#F1F5F9"
                                Foreground="#475569" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnCloseResetModal_Click"/>
                        <Button Grid.Column="2" Content="🔑 Cập Nhật Mật Khẩu" Height="40" Background="#D97706"
                                Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnConfirmResetPassword_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== MODAL 3: ROLE PERMISSION MATRIX ==================== -->
        <Grid x:Name="pnlPermissionMatrixModal" Visibility="Collapsed" Background="#80000000">
            <Border Width="860" MaxHeight="680" Background="White" CornerRadius="12" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="🛡️ BẢNG MA TRẬN PHÂN QUYỀN HỆ THỐNG (RBAC)" FontWeight="Bold" FontSize="16" Foreground="#0F172A"/>
                            <TextBlock Text="Chi tiết phân quyền tính năng giữa Quản trị viên (Admin) và Thủ kho (WarehouseKeeper)" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Width="30" Height="30"
                                Background="Transparent" Foreground="#64748B" FontSize="14" FontWeight="Bold"
                                BorderThickness="0" Cursor="Hand" Click="BtnClosePermissionModal_Click"/>
                    </DockPanel>

                    <!-- Table -->
                    <DataGrid x:Name="dgPermissions" Grid.Row="1" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              Background="White" BorderThickness="1" BorderBrush="#E2E8F0"
                              RowHeight="42" MaxHeight="450">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Height" Value="36"/>
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PHÂN HỆ" Binding="{Binding ModuleName}" Width="170" FontWeight="Bold"/>
                            <DataGridTextColumn Header="CHỨC NĂNG / TÁC VỤ" Binding="{Binding FeatureName}" Width="260"/>
                            <DataGridTemplateColumn Header="👑 QUẢN TRỊ VIÊN" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#DBEAFE" CornerRadius="10" Padding="8,3" HorizontalAlignment="Center">
                                            <TextBlock Text="✅ Cho phép" Foreground="#1E40AF" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="📦 THỦ KHO" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding WhBadgeBg}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding WhBadgeText}" Foreground="{Binding WhBadgeFg}" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="GHI CHÚ PHÂN QUYỀN" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer -->
                    <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="💡 Lưu ý: Chỉ Quản trị viên (Admin) mới có quyền sửa đổi quyền hạn và tạo tài khoản."
                                   FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="✕ Đóng" Height="36" Padding="18,0"
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1"
                                FontWeight="SemiBold" Cursor="Hand" Click="BtnClosePermissionModal_Click"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
