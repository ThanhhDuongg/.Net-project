<UserControl x:Class="FashionWarehouse.WpfApp.Views.CategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1050"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== CỘT TRÁI: Form thêm/sửa ===== -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,14,0">
            <StackPanel>
                <!-- Tiêu đề -->
                <TextBlock Text="📂 Quản Lý Danh Mục" FontWeight="Bold" FontSize="15"
                           Foreground="#1E293B" Margin="0,0,0,6"/>
                <TextBlock Text="Thêm, sửa, xóa danh mục hàng hóa thời trang." FontSize="12"
                           Foreground="#64748B" Margin="0,0,0,18"/>

                <!-- Tên danh mục -->
                <TextBlock Text="Tên danh mục *" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6"
                        Background="#F8FAFC" Padding="8,4" Margin="0,0,0,14">
                    <TextBox Name="txtCategoryName" FontSize="13" BorderThickness="0"
                             Background="Transparent" VerticalContentAlignment="Center"
                             Height="28"/>
                </Border>

                <!-- Mô tả -->
                <TextBlock Text="Mô tả" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6"
                        Background="#F8FAFC" Padding="8,6" Margin="0,0,0,20">
                    <TextBox Name="txtDescription" FontSize="12" BorderThickness="0"
                             Background="Transparent" AcceptsReturn="True"
                             TextWrapping="Wrap" Height="72"
                             VerticalScrollBarVisibility="Auto"/>
                </Border>

                <!-- Nút lưu + hủy -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Name="btnSave" Grid.Column="0" Click="BtnSave_Click" Height="42"
                            Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand">
                        <TextBlock Name="txtSaveButton" Text="+ Thêm Danh Mục" FontWeight="Bold"/>
                    </Button>
                    <Button Name="btnCancel" Grid.Column="2" Click="BtnCancel_Click" Height="42"
                            Background="#E2E8F0" Foreground="#334155" BorderThickness="0"
                            Cursor="Hand" Visibility="Collapsed">
                        <TextBlock Text="✕ Hủy Sửa" FontWeight="SemiBold"/>
                    </Button>
                </Grid>

                <!-- Thông báo kết quả -->
                <Border Name="brdMessage" Visibility="Collapsed" CornerRadius="6"
                        Padding="12,10" Margin="0,14,0,0">
                    <TextBlock Name="txtMessage" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>

                <!-- Hướng dẫn -->
                <Border Background="#EFF6FF" CornerRadius="6" Padding="12,10" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="💡 Hướng dẫn sử dụng" FontWeight="SemiBold" FontSize="12"
                                   Foreground="#1D4ED8" Margin="0,0,0,6"/>
                        <TextBlock FontSize="11" Foreground="#3730A3" TextWrapping="Wrap" LineHeight="18">
                            <Run Text="• Double-click dòng hoặc bấm 'Sửa' để chỉnh sửa"/>
                            <LineBreak/>
                            <Run Text="• Không thể xóa danh mục đang có sản phẩm"/>
                            <LineBreak/>
                            <Run Text="• Danh mục được load từ API hoặc dữ liệu mẫu khi offline"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== CỘT PHẢI: Danh sách danh mục ===== -->
        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Danh Sách Danh Mục Sản Phẩm" FontWeight="Bold"
                                   FontSize="15" Foreground="#1E293B" VerticalAlignment="Center"/>
                        <Border Name="brdCount" Background="#EFF6FF" CornerRadius="12"
                                Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Name="txtCount" Text="0 danh mục" Foreground="#2563EB"
                                       FontWeight="SemiBold" FontSize="11"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Click="BtnRefresh_Click" Height="32" Padding="12,0"
                            Background="#F1F5F9" Foreground="#475569" BorderThickness="0" Cursor="Hand">
                        <TextBlock Text="🔄 Làm mới" FontSize="12"/>
                    </Button>
                </Grid>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1" Name="dgCategories" AutoGenerateColumns="False"
                          CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                          Background="Transparent" RowHeight="52" BorderThickness="0"
                          MouseDoubleClick="DgCategories_MouseDoubleClick">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding CategoryId}" Width="45">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Tên Danh Mục" Binding="{Binding CategoryName}" Width="190">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#1E293B"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Mô Tả" Binding="{Binding Description}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Số SP" Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="8,2" HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F0FDF4"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ProductCount}" Value="0">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ProductCount}" FontWeight="Bold" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProductCount}" Value="0">
                                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Thao tác" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                        <Button Content="✏ Sửa" Tag="{Binding CategoryId}"
                                                Click="BtnEdit_Click" Height="30" Padding="10,0"
                                                Background="#EFF6FF" Foreground="#2563EB"
                                                BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" FontSize="12"/>
                                        <Button Content="🗑 Xóa" Tag="{Binding CategoryId}"
                                                Click="BtnDelete_Click" Height="30" Padding="10,0"
                                                Background="#FEF2F2" Foreground="#DC2626"
                                                BorderThickness="0" Cursor="Hand" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
