<UserControl x:Class="FashionWarehouse.WpfApp.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" Background="#F8FAFC">
    <Grid Margin="4,0,4,0">
        <Grid.RowDefinitions>
            <!-- 0: KPI Header Cards -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Filter & Action Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Main Content (DataGrid / Shelf Cards) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== 0. KPI CARDS ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: SKU -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TỔNG MÃ HÀNG (SKU)" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="txtRows" Text="0" FontSize="26" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,6,0,2"/>
                    <TextBlock Text="Mặt hàng đang quản lý" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Tổng tồn kho -->
            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TỔNG SỐ LƯỢNG TỒN" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="txtQuantity" Text="0" FontSize="26" FontWeight="ExtraBold" Foreground="#2563EB" Margin="0,6,0,2"/>
                    <TextBlock Text="Chiếc/bộ sản phẩm trong kho" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Cảnh báo cần nhập -->
            <Border Grid.Column="4" Background="White" CornerRadius="10" Padding="16,14" BorderBrush="#FECACA" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="CẢNH BÁO CẦN NHẬP" FontSize="11" FontWeight="Bold" Foreground="#DC2626"/>
                    <TextBlock x:Name="txtLowStock" Text="0" FontSize="26" FontWeight="ExtraBold" Foreground="#DC2626" Margin="0,6,0,2"/>
                    <TextBlock Text="SKU dưới ngưỡng an toàn" FontSize="11" Foreground="#EF4444"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Kệ lưu trữ -->
            <Border Grid.Column="6" Background="White" CornerRadius="10" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="VỊ TRÍ KỆ ĐANG DÙNG" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="txtLocationCount" Text="0" FontSize="26" FontWeight="ExtraBold" Foreground="#0D9488" Margin="0,6,0,2"/>
                    <TextBlock Text="Khu vực kệ lưu trữ hoạt động" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 1. FILTER & ACTION BAR ==================== -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <TextBox x:Name="txtSearch" Grid.Column="0" Height="38" Padding="10,6"
                         VerticalContentAlignment="Center" FontSize="13"
                         ToolTip="Tìm theo SKU, mã vạch, tên sản phẩm, màu sắc, vị trí kệ..."
                         TextChanged="Filters_Changed"/>

                <!-- Location Filter -->
                <ComboBox x:Name="cboLocation" Grid.Column="2" Height="38" VerticalContentAlignment="Center"
                          FontSize="13" SelectionChanged="Filters_Changed"/>

                <!-- Stock Status Filter -->
                <ComboBox x:Name="cboStockStatus" Grid.Column="4" Height="38" VerticalContentAlignment="Center"
                          FontSize="13" SelectionChanged="Filters_Changed">
                    <ComboBoxItem Content="Tất cả trạng thái tồn" IsSelected="True"/>
                    <ComboBoxItem Content="⚠️ Cần nhập thêm (&lt;= Ngưỡng)"/>
                    <ComboBoxItem Content="❌ Hết hàng (= 0)"/>
                    <ComboBoxItem Content="✅ Tồn kho an toàn"/>
                </ComboBox>

                <!-- View Toggle Buttons -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="rbListView" Content="📋 Chi tiết SKU" IsChecked="True"
                                 Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                 Checked="ViewMode_Changed"/>
                    <RadioButton x:Name="rbShelfView" Content="🏬 Sơ đồ Kệ"
                                 VerticalAlignment="Center" FontWeight="SemiBold"
                                 Checked="ViewMode_Changed"/>
                </StackPanel>

                <!-- Refresh Button -->
                <Button Grid.Column="8" Content="🔄 Làm mới" Height="38" Padding="14,0"
                        Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" BorderBrush="#CBD5E1"
                        Cursor="Hand" Click="BtnRefresh_Click"/>

                <!-- Export Button -->
                <Button Grid.Column="10" Content="📥 Xuất Excel" Height="38" Padding="16,0"
                        Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" Click="BtnExportExcel_Click"/>
            </Grid>
        </Border>

        <!-- ==================== 2. CONTENT AREA ==================== -->
        <Grid Grid.Row="2">
            <!-- Mode 1: Detailed SKU DataGrid -->
            <Border x:Name="pnlListView" Background="White" CornerRadius="10" Padding="12"
                    BorderBrush="#E2E8F0" BorderThickness="1" Visibility="Visible">
                <DataGrid x:Name="dgInventory" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="44"
                          Background="White" BorderThickness="0" SelectionMode="Single"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Height" Value="38"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Height" Value="42"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã SKU" Binding="{Binding SKU}" FontWeight="Bold" Width="140"/>
                        <DataGridTemplateColumn Header="Mã vạch (Barcode)" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="BtnViewBarcode_Click" Tag="{Binding}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2,0"
                                            ToolTip="Bấm để xem Barcode lớn và thao tác Nhập/Xuất kho">
                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,3" BorderBrush="#CBD5E1" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🔍 " FontSize="11"/>
                                                <TextBlock Text="{Binding Barcode}" FontFamily="Consolas" FontWeight="Bold" Foreground="#2563EB"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding ProductName}" Width="2*"/>
                        <DataGridTextColumn Header="Màu sắc" Binding="{Binding ColorName}" Width="100"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeName}" Width="70"/>
                        
                        <!-- Location Badge -->
                        <DataGridTemplateColumn Header="Vị trí kệ" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                            CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding LocationCode}" Foreground="#1D4ED8" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Tồn kho" Binding="{Binding QuantityOnHand, StringFormat={}{0:N0}}" FontWeight="Bold" Width="85"/>
                        <DataGridTextColumn Header="Ngưỡng" Binding="{Binding SafetyStock, StringFormat={}{0:N0}}" Foreground="#64748B" Width="80"/>
                        <DataGridTextColumn Header="Giá vốn" Binding="{Binding CostPrice, StringFormat={}{0:N0} đ}" Width="110"/>
                        <DataGridTextColumn Header="Giá trị tồn" Binding="{Binding TotalValue, StringFormat={}{0:N0} đ}" FontWeight="SemiBold" Foreground="#047857" Width="130"/>

                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="Trạng thái" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusBgColor}" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFgColor}" FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Mode 2: Shelf Location Matrix Cards -->
            <Border x:Name="pnlShelfView" Background="White" CornerRadius="10" Padding="18"
                    BorderBrush="#E2E8F0" BorderThickness="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="SƠ ĐỒ PHÂN BỔ HÀNG HÓA THEO VỊ TRÍ KỆ" FontWeight="Bold" FontSize="15" Foreground="#1E293B" Margin="0,0,0,6"/>
                        <TextBlock Text="Bấm vào một kệ hàng để lọc nhanh các sản phẩm đang được lưu trữ tại kệ đó." FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>

                        <ItemsControl x:Name="icShelfCards">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="280" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                                            CornerRadius="8" Padding="16" Margin="0,0,16,16">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding LocationCode}" FontWeight="ExtraBold" FontSize="16" Foreground="#1E293B" DockPanel.Dock="Left"/>
                                                <Border Background="#DBEAFE" CornerRadius="10" Padding="8,2" DockPanel.Dock="Right">
                                                    <TextBlock Text="{Binding ShelfType}" Foreground="#1D4ED8" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                            </DockPanel>

                                            <TextBlock Text="{Binding LocationName}" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12" Height="32"/>

                                            <Border Background="White" CornerRadius="6" Padding="10,8" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Mặt hàng (SKU)" FontSize="10" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding SkuCount}" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Tổng chiếc tồn" FontSize="10" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding TotalQuantity, StringFormat={}{0:N0}}" FontWeight="Bold" FontSize="15" Foreground="#2563EB"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Button Content="🔍 Xem hàng trên kệ" Height="32" Background="#2563EB" Foreground="White"
                                                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                                    Tag="{Binding LocationCode}" Click="BtnFilterByLocation_Click"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>