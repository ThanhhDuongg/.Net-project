<UserControl x:Class="FashionWarehouse.WpfApp.Views.CustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- KPI Cards -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1 -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="TỔNG ĐỐI TÁC KHÁCH HÀNG" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="txtKpiTotal" Text="0" FontSize="26" FontWeight="Bold" Foreground="#1E293B" Margin="0,6,0,2"/>
                    <TextBlock Text="Đại lý phân phối &amp; Khách mua buôn" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Card 2 -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="ĐẠI LÝ CẤP 1 &amp; CẤP 2" FontSize="11" FontWeight="Bold" Foreground="#2563EB"/>
                    <TextBlock x:Name="txtKpiAgencies" Text="0" FontSize="26" FontWeight="Bold" Foreground="#3B82F6" Margin="0,6,0,2"/>
                    <TextBlock Text="Kênh phân phối chủ lực hệ thống" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Card 3 -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="KHÁCH MUA SỈ &amp; SHOWROOM" FontSize="11" FontWeight="Bold" Foreground="#059669"/>
                    <TextBlock x:Name="txtKpiRetail" Text="0" FontSize="26" FontWeight="Bold" Foreground="#10B981" Margin="0,6,0,2"/>
                    <TextBlock Text="Khách hàng xuất kho thường xuyên" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Thanh tìm kiếm, lọc loại KH & Thao tác (WrapPanel responsive) -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <!-- Search -->
                <Grid Width="240" Margin="0,0,8,6">
                    <TextBox x:Name="txtSearch" Height="36" Padding="8,0" VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_TextChanged"/>
                    <TextBlock Text="🔍 Tìm theo mã, tên, SĐT..." Foreground="#94A3B8"
                               VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Filter type -->
                <ComboBox x:Name="cboFilterType" Width="150" Height="36" Margin="0,0,8,6" SelectedIndex="0"
                          VerticalContentAlignment="Center" SelectionChanged="CboFilterType_SelectionChanged">
                    <ComboBoxItem Content="Tất cả phân loại"/>
                    <ComboBoxItem Content="Đại lý cấp 1"/>
                    <ComboBoxItem Content="Đại lý cấp 2"/>
                    <ComboBoxItem Content="Khách mua sỉ"/>
                    <ComboBoxItem Content="Khách mua lẻ"/>
                </ComboBox>

                <Button Click="BtnRefresh_Click" Height="36" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" Padding="12,0" Margin="0,0,8,6" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                    <TextBlock Text="🔄 Làm Mới"/>
                </Button>

                <Button Click="BtnNewCustomer_Click" Height="36" Background="#2563EB" Foreground="White" BorderThickness="0" Padding="14,0" Margin="0,0,0,6" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                    <TextBlock Text="+ Thêm Khách Hàng / Đại Lý" FontWeight="Bold"/>
                </Button>

                <TextBlock x:Name="lblStatusMessage" VerticalAlignment="Center" Margin="12,0,0,6"
                           FontWeight="SemiBold" FontSize="12" Foreground="#059669"/>
            </WrapPanel>
        </Border>

        <!-- 2 Cột: Bảng dữ liệu Khách hàng & Form thêm/sửa -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Bảng danh sách Khách hàng -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="14" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Danh Sách Đại Lý &amp; Khách Hàng Xuất Kho" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                        <TextBlock x:Name="lblCount" Text="0 khách hàng" HorizontalAlignment="Right" Foreground="#64748B" FontSize="12"/>
                    </Grid>

                    <DataGrid x:Name="dgCustomers" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" RowHeight="42"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              BorderThickness="0" Background="Transparent"
                              SelectionChanged="DgCustomers_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã KH" Width="75" Binding="{Binding CustomerCode}" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Tên Khách Hàng / Đại Lý" Width="1.3*" MinWidth="130" Binding="{Binding CustomerName}" FontWeight="Bold"/>
                            <DataGridTemplateColumn Header="Phân Loại" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="5,2" HorizontalAlignment="Left"
                                                Background="{Binding TypeBgColor}">
                                            <TextBlock Text="{Binding CustomerType}" FontWeight="SemiBold" FontSize="10.5"
                                                       Foreground="{Binding TypeFgColor}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Điện Thoại" Width="95" Binding="{Binding PhoneNumber}"/>
                            <DataGridTextColumn Header="Địa Chỉ Giao Hàng" Width="*" MinWidth="110" Binding="{Binding Address}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Cột phải: Form Thêm / Cập nhật Khách Hàng -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="18">
                <StackPanel>
                    <TextBlock x:Name="lblFormTitle" Text="THÊM MỚI KHÁCH HÀNG / ĐẠI LÝ" FontWeight="Bold" FontSize="15" Foreground="#1E293B" Margin="0,0,0,14"/>

                    <TextBlock Text="Mã khách hàng (Để trống để tự sinh):" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtCustomerCode" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Text="Tên khách hàng / Đại lý / Shop: *" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtCustomerName" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Text="Phân loại khách hàng: *" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cboCustomerType" Height="36" SelectedIndex="0" Margin="0,0,0,12">
                        <ComboBoxItem Content="Đại lý cấp 1"/>
                        <ComboBoxItem Content="Đại lý cấp 2"/>
                        <ComboBoxItem Content="Khách mua sỉ"/>
                        <ComboBoxItem Content="Khách mua lẻ"/>
                    </ComboBox>

                    <TextBlock Text="Số điện thoại:" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtPhoneNumber" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Text="Email liên hệ:" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtEmail" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Text="Địa chỉ nhận hàng / Cửa hàng:" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtAddress" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Padding="8" Margin="0,0,0,20"/>

                    <Button Click="BtnSave_Click" Height="42" Background="#2563EB" Foreground="White" BorderThickness="0" Margin="0,0,0,10" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock x:Name="btnSaveText" Text="LƯU KHÁCH HÀNG" FontWeight="Bold"/>
                    </Button>

                    <Button x:Name="btnDelete" Click="BtnDelete_Click" Height="36" Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Margin="0,0,0,10" Visibility="Collapsed" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="Ngưng Giao Dịch KH Này" FontWeight="SemiBold"/>
                    </Button>

                    <Button Click="BtnCancel_Click" Height="36" Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="Hủy Bỏ / Làm Mới Form"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

