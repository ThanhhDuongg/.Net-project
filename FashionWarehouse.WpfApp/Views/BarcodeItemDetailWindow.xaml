<Window x:Class="FashionWarehouse.WpfApp.Views.BarcodeItemDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi Tiết Mã Vạch &amp; Thao Tác Kho" Height="530" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0F172A" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Product info -->
            <RowDefinition Height="*"/>    <!-- Barcode card -->
            <RowDefinition Height="Auto"/> <!-- Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="🏷️ TEM MÃ VẠCH SẢN PHẨM" FontWeight="Bold" FontSize="16" Foreground="#38BDF8"/>
            <TextBlock Text="Dùng camera điện thoại quét trực tiếp mã này trên màn hình" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Product info card -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="14,12" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="txtProductName" Text="Áo Polo Nam Classic Cotton" FontWeight="Bold" FontSize="14" Foreground="White"/>
                    <TextBlock x:Name="txtVariantSummary" Text="Màu: Đen — Size: L" FontSize="12" Foreground="#CBD5E1" Margin="0,4,0,0"/>
                    <TextBlock x:Name="txtSku" Text="SKU: POLO01-BLK-L" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" FontFamily="Consolas"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#065F46" CornerRadius="6" Padding="8,4" Margin="0,0,0,4">
                        <TextBlock x:Name="txtStock" Text="Tồn: 40 cái" Foreground="#6EE7B7" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Background="#1E3A8A" CornerRadius="6" Padding="8,4">
                        <TextBlock x:Name="txtLocation" Text="Kệ: KHO-A-01" Foreground="#93C5FD" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barcode Card -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,18"
                BorderBrush="#E2E8F0" BorderThickness="2">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="MÃ VẠCH TIÊU CHUẨN CODE 128" FontSize="10" FontWeight="Bold" Foreground="#64748B"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <Image x:Name="imgBarcode" Height="85" MaxWidth="380" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"/>
                <TextBlock x:Name="txtBarcodeValue" Text="893600100102" FontSize="16" FontWeight="Bold"
                           Foreground="#0F172A" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Text="⚡ Camera điện thoại nhận diện tức thì trong 0.05s" FontSize="11" Foreground="#10B981"
                           HorizontalAlignment="Center" Margin="0,6,0,0" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Click="BtnOpenImport_Click" Grid.Column="0" Height="40" Background="#2563EB" Foreground="White"
                    BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="12">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                <TextBlock Text="📥 Nhập Thêm Hàng"/>
            </Button>

            <Button Click="BtnOpenExport_Click" Grid.Column="2" Height="40" Background="#059669" Foreground="White"
                    BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="12">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                <TextBlock Text="📤 Xuất Bán Hàng"/>
            </Button>

            <Button Click="BtnClose_Click" Grid.Column="4" Height="40" Background="#334155" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Padding="14,0" FontSize="12">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                <TextBlock Text="Đóng"/>
            </Button>
        </Grid>
    </Grid>
</Window>
