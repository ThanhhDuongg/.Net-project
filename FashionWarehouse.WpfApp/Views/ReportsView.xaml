<UserControl x:Class="FashionWarehouse.WpfApp.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" Background="#F8FAFC">
    <Grid Margin="4,0,4,0">
        <Grid.RowDefinitions>
            <!-- 0: Date Filter Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Financial & Volume KPI Cards -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Report Tabs (Movements, Transactions, Restock) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== 0. DATE FILTER BAR (WrapPanel responsive) ==================== -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="12,10" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="KHOẢNG THỜI GIAN:" FontWeight="Bold" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,6"/>
                
                <!-- Quick Presets -->
                <Button Content="Hôm nay" Padding="9,4" Margin="0,0,5,6" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Cursor="Hand" Click="BtnPresetToday_Click"/>
                <Button Content="7 ngày" Padding="9,4" Margin="0,0,5,6" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Cursor="Hand" Click="BtnPreset7Days_Click"/>
                <Button Content="14 ngày" Padding="9,4" Margin="0,0,5,6" Background="#DBEAFE" Foreground="#1D4ED8" FontWeight="Bold" BorderBrush="#93C5FD" Cursor="Hand" Click="BtnPreset14Days_Click"/>
                <Button Content="30 ngày" Padding="9,4" Margin="0,0,12,6" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Cursor="Hand" Click="BtnPreset30Days_Click"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,10,6" VerticalAlignment="Center">
                    <TextBlock Text="Từ ngày" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#475569" FontSize="11.5"/>
                    <DatePicker x:Name="dpFrom" Width="120" Height="34" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Đến ngày" VerticalAlignment="Center" Margin="8,0,5,0" Foreground="#475569" FontSize="11.5"/>
                    <DatePicker x:Name="dpTo" Width="120" Height="34" VerticalContentAlignment="Center"/>
                </StackPanel>

                <Button Content="🔍 Xem thống kê" Height="34" Padding="12,0" Margin="0,0,10,6"
                        Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" Click="BtnRefresh_Click"/>

                <Button Content="📥 Xuất Báo Cáo Excel (.xlsx)" Height="34" Padding="14,0" Margin="0,0,0,6"
                        Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" Click="BtnExport_Click"/>
            </WrapPanel>
        </Border>

        <!-- ==================== 1. KPI CARDS ==================== -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Giá trị tồn kho -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TỔNG GIÁ TRỊ TỒN KHO" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="txtInventoryValue" Text="0 đ" FontSize="24" FontWeight="ExtraBold" Foreground="#2563EB" Margin="0,6,0,2"/>
                    <TextBlock Text="Định giá tồn theo giá vốn thực tế" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Tổng nhập trong kỳ -->
            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TỔNG NHẬP TRONG KỲ" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="txtTotalImports" Text="0" FontSize="24" FontWeight="ExtraBold" Foreground="#10B981" Margin="0,6,0,2"/>
                    <TextBlock Text="Chiếc hàng hóa nhập vào kho" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Tổng xuất trong kỳ -->
            <Border Grid.Column="4" Background="White" CornerRadius="10" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TỔNG XUẤT TRONG KỲ" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="txtTotalExports" Text="0" FontSize="24" FontWeight="ExtraBold" Foreground="#F59E0B" Margin="0,6,0,2"/>
                    <TextBlock Text="Chiếc hàng hóa xuất khỏi kho" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Chênh lệch ròng (Net Flow) -->
            <Border Grid.Column="6" Background="White" CornerRadius="10" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="CHÊNH LỆCH RÒNG (NHẬP - XUẤT)" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="txtNetFlow" Text="0" FontSize="24" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,6,0,2"/>
                    <TextBlock Text="Mức độ luân chuyển ròng kho" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 2. REPORT TABS ==================== -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
            <TabControl BorderThickness="0" Background="Transparent">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="16,10"/>
                        <Setter Property="Margin" Value="0,0,4,0"/>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: Biến động nhập xuất theo ngày -->
                <TabItem Header="📊 Biến Động Nhập / Xuất Theo Ngày">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="txtStatus" Text="Chọn khoảng ngày để xem dữ liệu." Foreground="#64748B" FontSize="12" Margin="0,0,0,10"/>

                        <DataGrid Grid.Row="1" x:Name="dgMovements" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="42">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ngày ghi nhận" Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" FontWeight="Bold" Width="160"/>
                                <DataGridTextColumn Header="Số lượng nhập (+)" Binding="{Binding Imports, StringFormat={}{0:N0}}" Foreground="#10B981" FontWeight="Bold" Width="180"/>
                                <DataGridTextColumn Header="Số lượng xuất (-)" Binding="{Binding Exports, StringFormat={}{0:N0}}" Foreground="#EF4444" FontWeight="Bold" Width="180"/>
                                <DataGridTextColumn Header="Biến động ròng" Binding="{Binding NetChange, StringFormat={}{0:+0;-0;0}}" FontWeight="Bold" Width="180"/>
                                <DataGridTextColumn Header="Ghi chú đánh giá" Binding="{Binding Note}" Foreground="#64748B" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- TAB 2: Sổ Nhật Ký Giao Dịch Kho (Audit Log) -->
                <TabItem Header="📑 Sổ Nhật Ký Giao Dịch Kho (Thẻ Kho)">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search in log -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBox x:Name="txtSearchLog" Width="320" Height="34" Padding="8,4"
                                     VerticalContentAlignment="Center" FontSize="12"
                                     ToolTip="Tìm kiếm theo mã phiếu, SKU, vị trí kệ, người thực hiện..."
                                     TextChanged="TxtSearchLog_TextChanged" DockPanel.Dock="Left"/>
                            <TextBlock x:Name="txtLogCount" Text="0 giao dịch" VerticalAlignment="Center"
                                       Foreground="#64748B" Margin="14,0,0,0" DockPanel.Dock="Left"/>
                            <Button Content="🔄 Tải lại sổ giao dịch" Height="34" Padding="12,0"
                                    Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1"
                                    Cursor="Hand" DockPanel.Dock="Right" Click="BtnRefreshTransactions_Click"/>
                        </DockPanel>

                        <DataGrid Grid.Row="1" x:Name="dgTransactions" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="42">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã phiếu" Binding="{Binding ReferenceNo}" FontWeight="Bold" Width="130"/>
                                <DataGridTextColumn Header="Thời gian" Binding="{Binding OccurredAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="140"/>
                                
                                <!-- Transaction Type Badge -->
                                <DataGridTemplateColumn Header="Loại giao dịch" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding TypeBgColor}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding TypeDisplay}" Foreground="{Binding TypeFgColor}" FontWeight="Bold" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" FontWeight="SemiBold" Width="130"/>
                                <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding ProductName}" Width="2*"/>
                                <DataGridTextColumn Header="Kệ" Binding="{Binding LocationCode}" Width="90"/>
                                <DataGridTextColumn Header="Số lượng" Binding="{Binding QuantityDisplay}" FontWeight="Bold" Foreground="{Binding QuantityColor}" Width="100"/>
                                <DataGridTextColumn Header="Tồn trước" Binding="{Binding QuantityBefore, StringFormat={}{0:N0}}" Foreground="#64748B" Width="85"/>
                                <DataGridTextColumn Header="Tồn sau" Binding="{Binding QuantityAfter, StringFormat={}{0:N0}}" FontWeight="Bold" Width="85"/>
                                <DataGridTextColumn Header="Ghi chú" Binding="{Binding Notes}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- TAB 3: Dự Báo Hàng Cần Nhập Thêm -->
                <TabItem Header="🔔 Dự Báo Đặt Hàng Bổ Sung">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="DANH SÁCH MẶT HÀNG DƯỚI NGƯỠNG AN TOÀN" FontWeight="Bold" Foreground="#991B1B" FontSize="13"/>
                                    <TextBlock Text="Đề xuất số lượng đặt hàng tối ưu = (Ngưỡng an toàn × 2) - Tồn kho hiện tại." FontSize="11" Foreground="#B91C1C" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Tổng vốn cần nhập bổ sung:" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                    <TextBlock x:Name="txtEstimatedCost" Text="0 đ" FontWeight="ExtraBold" Foreground="#DC2626" FontSize="15" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <DataGrid Grid.Row="1" x:Name="dgRestock" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="42">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" FontWeight="Bold" Width="140"/>
                                <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding ProductName}" Width="2*"/>
                                <DataGridTextColumn Header="Màu &amp; Size" Binding="{Binding VariantDetail}" Width="120"/>
                                <DataGridTextColumn Header="Vị trí kệ" Binding="{Binding LocationCode}" Width="100"/>
                                <DataGridTextColumn Header="Tồn hiện tại" Binding="{Binding QuantityOnHand}" FontWeight="Bold" Foreground="#DC2626" Width="95"/>
                                <DataGridTextColumn Header="Ngưỡng an toàn" Binding="{Binding SafetyStock}" Foreground="#64748B" Width="110"/>
                                <DataGridTextColumn Header="Đề xuất nhập" Binding="{Binding SuggestedOrderQty}" FontWeight="ExtraBold" Foreground="#1D4ED8" Width="110"/>
                                <DataGridTextColumn Header="Giá vốn dự kiến" Binding="{Binding CostPrice, StringFormat={}{0:N0} đ}" Width="110"/>
                                <DataGridTextColumn Header="Thành tiền cần nhập" Binding="{Binding EstimatedCost, StringFormat={}{0:N0} đ}" FontWeight="Bold" Foreground="#047857" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>