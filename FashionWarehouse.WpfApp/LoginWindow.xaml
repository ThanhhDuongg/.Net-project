<Window x:Class="FashionWarehouse.WpfApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng Nhập - Hệ Thống Quản Lý Kho Thời Trang (Fashion WMS)"
        Height="540" Width="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#F1F5F9">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Brand Banner -->
        <Border Grid.Column="0" Background="#1E293B">
            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="10" Background="#2563EB">
                        <TextBlock Text="FW" FontWeight="Bold" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="FASHION WMS" FontWeight="Bold" FontSize="18" Foreground="White"/>
                        <TextBlock Text="Smart Warehouse" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Hệ Thống Quản Trị Kho" FontSize="20" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="Quản lý biến thể đa kích cỡ, màu sắc, quét mã vạch Barcode và kiểm soát tồn kho tức thời." 
                               FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="20"/>

                    <Border Background="#334155" CornerRadius="8" Padding="14" Margin="0,25,0,0">
                        <StackPanel>
                            <TextBlock Text="Tài khoản dùng thử (Seed):" FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,6"/>
                            <TextBlock Text="• admin / password (Quản trị)" FontSize="12" Foreground="#E2E8F0"/>
                            <TextBlock Text="• thukho / password (Thủ kho)" FontSize="12" Foreground="#E2E8F0" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="© 2026 Fashion Warehouse WMS v2.0" FontSize="11" Foreground="#64748B"/>
            </Grid>
        </Border>

        <!-- Right Login Form -->
        <Border Grid.Column="1" Background="White" Padding="45,35">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Đăng Nhập Hệ Thống" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Vui lòng nhập thông tin xác thực để truy cập hệ thống" FontSize="13" Foreground="#64748B" Margin="0,6,0,24"/>

                <!-- Error Message Alert -->
                <Border Name="brdAlert" Visibility="Collapsed" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,18">
                    <TextBlock Name="txtAlert" Text="" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>

                <!-- Username Input -->
                <TextBlock Text="Tên đăng nhập" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,6"/>
                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="#F8FAFC" Padding="8,4" Margin="0,0,0,16">
                    <TextBox Name="txtUsername" FontSize="14" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" KeyDown="Input_KeyDown" Text="admin"/>
                </Border>

                <!-- Password Input -->
                <TextBlock Text="Mật khẩu" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,6"/>
                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="#F8FAFC" Padding="8,4" Margin="0,0,0,22">
                    <PasswordBox Name="txtPassword" FontSize="14" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" KeyDown="Input_KeyDown" Password="password"/>
                </Border>

                <!-- Action Buttons -->
                <Button Name="btnLogin" Click="BtnLogin_Click" Height="44" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Name="txtLoginButton" Text="ĐĂNG NHẬP" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </Button>

                <!-- Quick Pick Account Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <TextBlock Text="Đăng nhập nhanh:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Click="BtnQuickAdmin_Click" Content="Admin" Padding="8,2" FontSize="11" Background="#E2E8F0" Foreground="#334155" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"/>
                    <Button Click="BtnQuickWarehouse_Click" Content="Thủ Kho" Padding="8,2" FontSize="11" Background="#E2E8F0" Foreground="#334155" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

