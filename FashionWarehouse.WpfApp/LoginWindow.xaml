<Window x:Class="FashionWarehouse.WpfApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng Nhập - Hệ Thống Quản Lý Kho Thời Trang (Fashion WMS)"
        Height="620" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#F1F5F9">
    <Window.Resources>
        <!-- Style cho TextBox & PasswordBox -->
        <Style x:Key="ModernInputField" TargetType="Control">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
        <!-- Main Card Container -->
        <Border Width="390" Background="White" CornerRadius="16" Padding="32,28" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Direction="270" ShadowDepth="6" Opacity="0.08" Color="#0F172A"/>
            </Border.Effect>

            <StackPanel>
                <!-- 1. Brand Logo & Title -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Width="72" Height="72" CornerRadius="16" Background="White" Padding="4"
                            BorderBrush="#E2E8F0" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                        </Border.Effect>
                        <Image Source="/Assets/logo.png" Stretch="Uniform"/>
                    </Border>

                    <TextBlock Text="FASHION WMS" FontWeight="ExtraBold" FontSize="22" Foreground="#0F172A" HorizontalAlignment="Center"/>
                    <TextBlock Text="Hệ Thống Quản Lý Kho Thời Trang" FontSize="12.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- 2. Error Alert Message -->
                <Border x:Name="brdAlert" Visibility="Collapsed" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️ " FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtAlert" Text="" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 3. Form Input Fields -->
                <!-- Username -->
                <TextBlock Text="Tên đăng nhập" FontWeight="SemiBold" FontSize="12.5" Foreground="#334155" Margin="0,0,0,6"/>
                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Background="#F8FAFC" Height="42" Padding="12,0" Margin="0,0,0,14">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="👤" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="txtUsername" Text="admin"
                                 FontSize="13.5" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" KeyDown="Input_KeyDown"/>
                    </Grid>
                </Border>

                <!-- Password -->
                <TextBlock Text="Mật khẩu" FontWeight="SemiBold" FontSize="12.5" Foreground="#334155" Margin="0,0,0,6"/>
                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Background="#F8FAFC" Height="42" Padding="12,0" Margin="0,0,0,20">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔒" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <PasswordBox Grid.Column="1" x:Name="txtPassword" Password="password"
                                     FontSize="13.5" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" KeyDown="Input_KeyDown"/>
                    </Grid>
                </Border>

                <!-- 4. Submit Button -->
                <Button x:Name="btnLogin" Click="BtnLogin_Click" Height="44" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <TextBlock x:Name="txtLoginButton" Text="ĐĂNG NHẬP" FontWeight="Bold" FontSize="14"/>
                </Button>

                <!-- 5. Quick Pick Test Accounts -->
                <Border Background="#F8FAFC" CornerRadius="8" Padding="10,8" Margin="0,18,0,0" BorderBrush="#F1F5F9" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Chọn nhanh tài khoản mẫu:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Click="BtnQuickAdmin_Click" Height="28" Padding="10,0" Margin="0,0,8,0"
                                    Background="#E2E8F0" Foreground="#1E293B" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                                <TextBlock Text="👑 Quản Trị (Admin)" FontSize="11" FontWeight="SemiBold"/>
                            </Button>

                            <Button Click="BtnQuickWarehouse_Click" Height="28" Padding="10,0"
                                    Background="#E2E8F0" Foreground="#1E293B" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                                <TextBlock Text="📦 Thủ Kho" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 6. Footer -->
                <TextBlock Text="© 2026 Fashion Warehouse WMS • v2.0" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
